diff --git a/ggml/src/ggml-remote-attn/ggml-remote-attn.cpp b/ggml/src/ggml-remote-attn/ggml-remote-attn.cpp
index e8b7096a6..0490cd96f 100644
--- a/ggml/src/ggml-remote-attn/ggml-remote-attn.cpp
+++ b/ggml/src/ggml-remote-attn/ggml-remote-attn.cpp
@@ -355,7 +355,13 @@ struct ggml_backend_remote_attn_buffer_context {
 static void ggml_backend_remote_attn_buffer_free(ggml_backend_buffer_t buffer) {
     auto * ctx = (ggml_backend_remote_attn_buffer_context *) buffer->context;
     if (ctx->base) {
+        // Must pair with the allocator below: the MSVC CRT requires
+        // _aligned_free for _aligned_malloc memory.
+#if defined(_WIN32)
+        _aligned_free(ctx->base);
+#else
         free(ctx->base);
+#endif
     }
     delete ctx;
 }
@@ -433,11 +439,19 @@ static ggml_backend_buffer_t ggml_backend_remote_attn_buft_alloc_buffer(
     ctx->size = size;
     if (size) {
         // 64-byte aligned host allocation
+#if defined(_WIN32)
+        void * ptr = _aligned_malloc(size, 64);
+        if (ptr == nullptr) {
+            delete ctx;
+            return nullptr;
+        }
+#else
         void * ptr = nullptr;
         if (posix_memalign(&ptr, 64, size) != 0 || ptr == nullptr) {
             delete ctx;
             return nullptr;
         }
+#endif
         memset(ptr, 0, size);
         ctx->base = ptr;
     }

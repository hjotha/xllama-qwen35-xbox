+// Copyright (c) 2024 Gianluca Mazza
+// SPDX-License-Identifier: MIT
+//
+// top_prob core, split out of mtp_draft.cpp so the max scan and the p_min
+// gate can be tested bit-exactly (tests/test_mtp_top_prob.cpp). The only
+// difference between the two max implementations is the scan; the exp
+// accumulation, the early exit and the return stay byte-for-byte the same.
+#pragma once
+
+namespace xllama {
+
+// Maximum of |logits| with the exact semantics of the original scalar loop:
+// the first element seeds the scan (a NaN seed is sticky), later NaNs are
+// ignored, ties keep the first occurrence including its signed-zero bit
+// pattern. |mtp_logits_max_avx| is bit-identical to
+// |mtp_logits_max_scalar| (256-bit AVX path; scalar fallback when the
+// translation unit is built without __AVX__). Callers must pass n >= 1.
+float mtp_logits_max_scalar(const float* logits, int n);
+float mtp_logits_max_avx(const float* logits, int n);
+
+// Exact top_prob: max scan, then the exp accumulation in strict ascending
+// index order with the early exit (1/sum < p_min is already decided). |avx|
+// selects the max-scan implementation only.
+float mtp_top_prob_core(const float* logits, int n_vocab, float p_min, bool avx);
+
+// Bench knob (bench_topprob_avx.txt): process-wide max-scan selector.
+void mtp_set_top_prob_avx(bool enabled);
+bool mtp_top_prob_avx_enabled();
+
+} // namespace xllama

diff --git a/src/bridge/mtp_top_prob.cpp b/src/bridge/mtp_top_prob.cpp
new file mode 100644
index 0000000..eb53fcb
--- /dev/null
+++ b/src/bridge/mtp_top_prob.cpp
@@ -0,0 +1,91 @@
+// Copyright (c) 2024 Gianluca Mazza
+// SPDX-License-Identifier: MIT
+//
+// Plan 006 C5: top_prob max scan. The scalar loop is the original one; the
+// AVX path scans 8 elements per step with an ordered-greater blend, which
+// keeps the scalar semantics exactly (later NaNs are never selected, a NaN
+// seed is sticky, ties keep the earlier element). See the header for the
+// contract and tests/test_mtp_top_prob.cpp for the adversarial suite.
+#include "xllama/mtp_top_prob.h"
+
+#include <cmath>
+
+#if defined(__AVX__)
+#include <immintrin.h>
+#endif
+
+namespace xllama {
+
+namespace {
+// Default OFF until the on-console paired proposal/acceptance traces, full
+// token IDs and timing pass; bench_topprob_avx.txt="1" selects the AVX scan.
+bool g_top_prob_avx = false;
+}
+
+float mtp_logits_max_scalar(const float* logits, int n) {
+    float max_l = logits[0];
+    for (int i = 1; i < n; ++i)
+        if (logits[i] > max_l)
+            max_l = logits[i];
+    return max_l;
+}
+
+float mtp_logits_max_avx(const float* logits, int n) {
+#if defined(__AVX__)
+    float max_l = logits[0];
+    __m256 vmax = _mm256_set1_ps(logits[0]);
+    int i = 1;
+    for (; i + 8 <= n; i += 8) {
+        const __m256 v = _mm256_loadu_ps(logits + i);
+        // Ordered GT: a NaN in |v| leaves its lane untouched (later NaNs are
+        // ignored, exactly like the scalar loop), and a NaN seed lane stays
+        // NaN for the same reason.
+        vmax = _mm256_blendv_ps(vmax, v, _mm256_cmp_ps(v, vmax, _CMP_GT_OQ));
+    }
+    float lanes[8];
+    _mm256_storeu_ps(lanes, vmax);
+    for (int k = 0; k < 8; ++k)
+        if (lanes[k] > max_l)
+            max_l = lanes[k];
+    for (; i < n; ++i)
+        if (logits[i] > max_l)
+            max_l = logits[i];
+    if (max_l == 0.0f) {
+        // +0 and -0 compare equal, so a lane fold can keep the later sign
+        // where the scalar loop keeps the first zero it meets. Re-scan only
+        // in that (rare) case to stay bit-identical.
+        for (int j = 0; j < n; ++j)
+            if (logits[j] == 0.0f)
+                return logits[j];
+    }
+    return max_l;
+#else
+    return mtp_logits_max_scalar(logits, n);
+#endif
+}
+
+float mtp_top_prob_core(const float* logits, int n_vocab, float p_min, bool avx) {
+    // Softmax probability of the drafted token from the draft context's own
+    // logits at |idx|. The candidate fails when 1/sum < p_min, i.e.
+    // sum > 1/p_min; every term is positive and the maximum logit's term is
+    // exactly 1, so once the running sum exceeds the limit the verdict cannot
+    // change. The sum keeps strict ascending-index scalar order and the limit
+    // is recomputed from the same p_min the caller gates on.
+    const float max_l = avx ? mtp_logits_max_avx(logits, n_vocab)
+                            : mtp_logits_max_scalar(logits, n_vocab);
+    const double limit = 1.0 / static_cast<double>(p_min);
+    double sum = 0.0;
+    for (int i = 0; i < n_vocab; ++i) {
+        sum += std::exp(static_cast<double>(logits[i] - max_l));
+        if (sum > limit)
+            return 0.0f; // 1/sum < p_min is already decided
+    }
+    // exp of the largest logit is 1 by construction, so it contributes
+    // exactly 1.
+    return static_cast<float>(1.0 / sum);
+}
+
+void mtp_set_top_prob_avx(bool enabled) { g_top_prob_avx = enabled; }
+bool mtp_top_prob_avx_enabled() { return g_top_prob_avx; }
+
+} // namespace xllama

diff --git a/tests/test_mtp_top_prob.cpp b/tests/test_mtp_top_prob.cpp
new file mode 100644
index 0000000..6f323d9
--- /dev/null
+++ b/tests/test_mtp_top_prob.cpp
@@ -0,0 +1,263 @@
+// Copyright (c) 2024 Gianluca Mazza
+// SPDX-License-Identifier: MIT
+//
+// Plan 006 C5: bit-exact adversarial tests for the top_prob max scan and the
+// p_min gate. The AVX path must return the same bits as the original scalar
+// loop for first-NaN (sticky), later-NaN (ignored), signed-zero/ties and
+// infinities, and the exp accumulation/early exit must be untouched.
+#include <doctest/doctest.h>
+
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+#include "xllama/mtp_top_prob.h"
+
+using namespace xllama;
+
+namespace {
+
+uint32_t bits(float f) {
+    uint32_t u;
+    std::memcpy(&u, &f, sizeof(u));
+    return u;
+}
+
+// Independent reference: the original scalar semantics.
+float ref_max(const float* a, int n) {
+    float m = a[0];
+    for (int i = 1; i < n; ++i)
+        if (a[i] > m)
+            m = a[i];
+    return m;
+}
+
+float ref_core(const float* a, int n, float p_min) {
+    const float m = ref_max(a, n);
+    const double limit = 1.0 / static_cast<double>(p_min);
+    double sum = 0.0;
+    for (int i = 0; i < n; ++i) {
+        sum += std::exp(static_cast<double>(a[i] - m));
+        if (sum > limit)
+            return 0.0f;
+    }
+    return static_cast<float>(1.0 / sum);
+}
+
+void check_max_bits(const std::vector<float>& a) {
+    const float s = mtp_logits_max_scalar(a.data(), static_cast<int>(a.size()));
+    const float v = mtp_logits_max_avx(a.data(), static_cast<int>(a.size()));
+    const float r = ref_max(a.data(), static_cast<int>(a.size()));
+    CHECK_MESSAGE(bits(s) == bits(r), "scalar vs reference");
+    CHECK_MESSAGE(bits(v) == bits(s), "avx vs scalar");
+}
+
+void check_core_bits(const std::vector<float>& a, float p_min) {
+    const int n = static_cast<int>(a.size());
+    const float ref = ref_core(a.data(), n, p_min);
+    const float sc = mtp_top_prob_core(a.data(), n, p_min, false);
+    const float av = mtp_top_prob_core(a.data(), n, p_min, true);
+    CHECK_MESSAGE(bits(sc) == bits(ref), "scalar core vs reference");
+    CHECK_MESSAGE(bits(av) == bits(ref), "avx core vs reference");
+}
+
+} // namespace
+
+TEST_CASE("c5: max scan bit-exact on adversarial patterns and every tail length") {
+    // Lengths 1..33: no vector block (1..8), one block + tail (9..16),
+    // two blocks + tail (17..25), full blocks (33 = 4*8 + 1).
+    for (int n = 1; n <= 33; ++n) {
+        for (int t = 0; t < 64; ++t) {
+            std::vector<float> a(n);
+            for (int i = 0; i < n; ++i)
+                a[i] = static_cast<float>((t * 7 + i * 13) % 5) - 2.0f; // ties
+            const int p = (t * 3) % n;
+            switch ((t / 3) % 6) {
+            case 1: a[p] = NAN; break;
+            case 2: a[p] = (t % 2) ? -0.0f : 0.0f; break;
+            case 3: a[p] = (t % 2) ? INFINITY : -INFINITY; break;
+            case 4: a[0] = NAN; break; // sticky seed
+            case 5: a[n - 1] = NAN; break;
+            default: break;
+            }
+            check_max_bits(a);
+            check_core_bits(a, 50.0f);
+        }
+    }
+}
+
+TEST_CASE("c5: max scan bit-exact on randomized arrays with specials") {
+    uint64_t s = 0x9E3779B97F4A7C15ull;
+    auto rnd = [&s]() {
+        s = s * 6364136223846793005ull + 1442695040888963407ull;
+        return static_cast<uint32_t>(s >> 33);
+    };
+    for (int rep = 0; rep < 400; ++rep) {
+        const int n = 1 + static_cast<int>(rnd() % 300);
+        std::vector<float> a(n);
+        for (int i = 0; i < n; ++i)
+            a[i] = static_cast<float>(static_cast<int>(rnd() % 2001) - 1000) * 0.001f;
+        for (int k = 0; k < 3; ++k) {
+            const int p = static_cast<int>(rnd() % n);
+            switch (rnd() % 4) {
+            case 0: a[p] = NAN; break;
+            case 1: a[p] = -0.0f; break;
+            case 2: a[p] = INFINITY; break;
+            default: a[p] = -INFINITY; break;
+            }
+        }
+        check_max_bits(a);
+    }
+    // One large array, vocab-sized, with specials at both ends.
+    std::vector<float> big(248320);
+    for (size_t i = 0; i < big.size(); ++i)
+        big[i] = static_cast<float>(static_cast<int>(rnd() % 2001) - 1000) * 0.01f;
+    big[0] = -0.0f;
+    big[1] = NAN;
+    big[12345] = INFINITY;
+    big[big.size() - 1] = 0.0f;
+    check_max_bits(big);
+}
+
+TEST_CASE("c5: p_min threshold boundaries stay exact") {
+    // All-equal logits: each term is 1.0, so the sum crosses 1/p_min at an
+    // exactly known index; p_min=0.5 -> limit=2.0 -> exit at the third term.
+    {
+        std::vector<float> a(16, 0.0f);
+        check_core_bits(a, 0.5f); // sum 3.0 > 2.0 at i=2
+        check_core_bits(a, 2.0f); // limit 0.5 -> exit at i=0 (sum 1.0 > 0.5)
+        check_core_bits(a, 50.0f);
+        check_core_bits(a, 1.0f);
+    }
+    // Exact tie with the limit: sum reaches exactly 2.0 and never exceeds it
+    // (later terms are exp(-inf)=0), so the full sum decides: 1/2.
+    {
+        std::vector<float> a = {0.0f, 0.0f, -INFINITY, -INFINITY, -INFINITY};
+        check_core_bits(a, 0.5f);
+    }
+    // One more unit term pushes the sum above the limit.
+    {
+        std::vector<float> a = {0.0f, 0.0f, 0.0f, -INFINITY, -INFINITY};
+        check_core_bits(a, 0.5f);
+    }
+    // Terms at 2^-k scale: crafted to sit near the limit in ULP terms.
+    {
+        std::vector<float> a = {0.0f, -0.6931472f, -1.3862944f, -2.0794415f, -2.7725887f, -3.465736f};
+        for (float pm : {0.5f, 0.7f, 0.8f, 1.0f, 1.3f, 1.5f, 50.0f})
+            check_core_bits(a, pm);
+    }
+    // Non-finite inputs: all -inf (max -inf -> NaN terms), all +inf, one 0
+    // with the rest -inf (sum 1.0), NaN seed.
+    {
+        std::vector<float> a(12, -INFINITY);
+        check_core_bits(a, 50.0f);
+        std::vector<float> b(12, INFINITY);
+        check_core_bits(b, 50.0f);
+        std::vector<float> c(12, -INFINITY);
+        c[7] = 0.0f;
+        check_core_bits(c, 50.0f);
+        check_core_bits(c, 0.5f);
+        std::vector<float> d(12, 1.0f);
+        d[0] = NAN;
+        check_core_bits(d, 50.0f);
+    }
+    // Signed-zero seed and zero ties at every position.
+    for (int pos = 0; pos < 9; ++pos) {
+        std::vector<float> a(9, -1.0f);
+        a[pos] = -0.0f;
+        a[(pos + 3) % 9] = 0.0f;
+        check_max_bits(a);
+        check_core_bits(a, 50.0f);
+    }
+}
+
+TEST_CASE("c5: nextafter p_min boundaries around the returned probability (n > 8)") {
+    // Unit terms (the rest exp(-inf)=0) make the sum an exact integer k, so
+    // the returned probability is 1/k and the limit 1/p_min lands exactly on
+    // it: candidates one float ULP around the probability must flip the gate
+    // identically in both paths.
+    for (int n : {9, 10, 16, 17, 33, 64}) {
+        const int k = 9; // unit terms
+        std::vector<float> a(n, -INFINITY);
+        for (int i = 0; i < k; ++i)
+            a[i] = 0.0f;
+        const float prob = static_cast<float>(1.0 / k);
+        const float cands[5] = {
+            std::nextafter(std::nextafter(prob, -INFINITY), -INFINITY),
+            std::nextafter(prob, -INFINITY),
+            prob,
+            std::nextafter(prob, INFINITY),
+            std::nextafter(std::nextafter(prob, INFINITY), INFINITY),
+        };
+        int exits = 0, completes = 0;
+        for (float pm : cands) {
+            check_core_bits(a, pm);
+            const float r = mtp_top_prob_core(a.data(), n, pm, true);
+            (r == 0.0f ? exits : completes)++;
+        }
+        CHECK(exits > 0);
+        CHECK(completes > 0);
+    }
+    // Non-trivial distribution: probabilities from the reference, candidates
+    // within a few ULPs of each returned value, n > 8 (block + tail).
+    uint64_t s = 0xC0FFEE123456789ull;
+    auto rnd = [&s]() {
+        s = s * 6364136223846793005ull + 1442695040888963407ull;
+        return static_cast<uint32_t>(s >> 33);
+    };
+    for (int rep = 0; rep < 40; ++rep) {
+        const int n = 9 + static_cast<int>(rnd() % 120);
+        std::vector<float> a(n);
+        for (int i = 0; i < n; ++i)
+            a[i] = static_cast<float>(static_cast<int>(rnd() % 2001) - 1000) * 0.01f;
+        const float prob = ref_core(a.data(), n, 1.0f); // no early exit at p_min=1
+        float pm = prob;
+        for (int u = 0; u < 4; ++u)
+            pm = std::nextafter(pm, -INFINITY);
+        for (int u = 0; u < 8; ++u) {
+            check_core_bits(a, pm);
+            pm = std::nextafter(pm, INFINITY);
+        }
+    }
+}
+
+TEST_CASE("c5: signed-zero maxima crossing lane order") {
+    // First zero in a later lane than another zero: lane0's zero sits at
+    // index 9 while lane1's sits at index 2, so a plain lane fold would keep
+    // the -0 from index 9; the scalar loop keeps the first zero, +0 at index
+    // 2. The canonicalization must recover the scalar sign.
+    {
+        std::vector<float> a(17, -1.0f);
+        a[2] = 0.0f;
+        a[9] = -0.0f;
+        check_max_bits(a);
+        check_core_bits(a, 50.0f);
+    }
+    {
+        std::vector<float> b(17, -1.0f);
+        b[2] = -0.0f;
+        b[9] = 0.0f;
+        check_max_bits(b);
+        check_core_bits(b, 50.0f);
+    }
+    // Same-lane zeros plus a scalar-tail zero.
+    {
+        std::vector<float> c(33, -1.0f);
+        c[0] = -0.0f;
+        c[8] = 0.0f;
+        c[16] = -0.0f;
+        c[32] = 0.0f;
+        check_max_bits(c);
+        check_core_bits(c, 50.0f);
+    }
+}
+
+TEST_CASE("c5: selector default is OFF and the knob enables the avx scan") {
+    const bool prev = mtp_top_prob_avx_enabled();
+    mtp_set_top_prob_avx(false);
+    CHECK_FALSE(mtp_top_prob_avx_enabled());
+    mtp_set_top_prob_avx(true);
+    CHECK(mtp_top_prob_avx_enabled());
+    mtp_set_top_prob_avx(prev);
+}

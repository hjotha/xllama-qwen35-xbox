+// TEST-ONLY T1b negative control (plan 009, Iteration builds). Reverted
+// after the T1 measurement.
+bool MtpDrafter::install_test_carry(const float* h, llama_pos pos, int n_embd) {
+    if (!m_ctx || !h || pos < 0 || n_embd != m_n_embd)
+        return false;
+    std::memcpy(m_pending_h.data(), h, static_cast<size_t>(n_embd) * sizeof(float));
+    m_pending_pos = pos;
+    m_pending_valid = true;
+    m_carry_valid = false; // a bare carry is not a committed prefix end
+    return true;
+}

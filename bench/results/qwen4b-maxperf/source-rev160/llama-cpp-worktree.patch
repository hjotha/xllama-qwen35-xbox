+    const ggml_tensor* w = op->src[0];
+    return w->ne[0] == 2560 && w->ne[1] == 4096 && w->type == GGML_TYPE_Q4_K &&
+           std::strcmp(w->name, "blk.0.attn_gate.weight") == 0;
